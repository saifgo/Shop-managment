# Tittawin Management System
# One file configures the whole stack.
#
# Deploy:
#   cp .env.example .env
#   docker compose up -d --build
#
# Local development (Vite + Mailpit):
#   docker compose -f docker-compose.dev.yml up -d --build

# Public URL of the app (used for generated links). Match HTTP_PORT.
APP_URL=http://localhost:8080
HTTP_PORT=8080
HTTP_BIND=0.0.0.0

# Symfony. Use a long random value in production.
APP_SECRET=change-me-to-a-long-random-string
APP_SHARE_DIR=var/share

# PostgreSQL. The password is applied only when the data volume is first created.
# Use a URL-safe password (letters and numbers). Characters like @ : / # break DATABASE_URL.
POSTGRES_DB=tittawin
POSTGRES_USER=tittawin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1

# Redis (internal). Override only if you point Messenger at an external Redis.
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages

# Browser origin allowed to call the API when PUBLIC_API_URL is a different host.
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# Mail. null://null discards mail. Use smtp://user:pass@host:587 for real delivery.
MAILER_DSN=null://null

# MinIO (bundled in Compose). Point MINIO_ENDPOINT at AWS S3 or another host to use external storage.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=tittawin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=tittawin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BIND=127.0.0.1

# Leave empty so the UI calls /api on the same host and port as the app.
# Set an absolute URL only when the API is served from a different origin.
PUBLIC_API_URL=
